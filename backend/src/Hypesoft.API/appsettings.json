{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning", 
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Microsoft.AspNetCore.Authorization": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information",
      "System.Net.Http": "Information"
    }
  },

  "Serilog": {
  "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
  "MinimumLevel": {
    "Default": "Debug",
    "Override": {
      "Microsoft": "Warning",
      "System": "Warning",
      "MongoDB": "Debug"
    }
  },
  "WriteTo": [
    { "Name": "Console" },
    {
      "Name": "File",
      "Args": {
        "path": "logs/log-.txt",
        "rollingInterval": "Day",
        "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
      }
    }
  ]
},


  "Keycloak": {
    "realm": "hypesoft",
    "auth-server-url": "http://keycloak:8080/",
    "ssl-required": "none",
    "resource": "hypesoft-backend",
    "verify-token-audience": false,
    "credentials": {
      "secret": "QYkuWJEVxBpTcA7naIFJId3JOijmswWW"
    },
    "confidential-port": 0
  },

  "AllowedHosts": "*",
  
  "MongoDbSettings": {
    "ConnectionString": "mongodb://root:example@mongodb:27017?authSource=admin",
    "DatabaseName": "hypesoft_challenge"
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000", 
      "https://localhost:3000",
      "http://localhost:3001",
      "https://localhost:3001", 
      "http://localhost:5000",
      "https://localhost:5000",
      "http://127.0.0.1:3000",
      "http://172.30.16.1:3000"
    ]
  }
}
